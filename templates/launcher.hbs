<div class="efx-ui ge-ui">
  <header class="efx-compact-head">
    <div class="ge-mark" aria-hidden="true">✦</div>
    <div class="ge-titles">
      <h1>Grim Encounter</h1>
      <p>Start Encounter</p>
    </div>
    <div class="efx-compact-status">GM</div>
    <button type="button" class="efx-x" data-act="close" title="Close">×</button>
  </header>

  <div class="efx-compact-body">
    <label class="efx-field">
      <span>Scene</span>
      <select name="sceneId" required>
        <option value="" disabled selected>Select Scene</option>
        {{#each scenes}}
          <option value="{{id}}">{{name}}{{#if active}} — Active{{/if}}</option>
        {{else}}
          <option value="" disabled>No scenes found</option>
        {{/each}}
      </select>
    </label>

    <div class="efx-field">
      <span>Flame</span>
      <div class="efx-flame-row" role="radiogroup" aria-label="Flame colour">
        {{#each flames}}
          <label class="efx-swatch" style="--sw: {{hex}}" title="{{name}}">
            <input type="radio" name="flame" value="{{hex}}" {{#if checked}}checked{{/if}}>
          </label>
        {{/each}}
        <label class="efx-swatch custom{{#if custom.set}} set{{/if}}" style="--sw: {{custom.hex}}" title="Custom colour">
          <input type="radio" name="flame" value="custom" {{#if custom.checked}}checked{{/if}}>
          <input type="color" name="flameCustom" value="{{custom.hex}}" aria-label="Custom flame colour">
        </label>
        <span class="efx-flame-name">{{flameName}}</span>
      </div>
    </div>

    <div class="efx-compact-options">
      <div class="efx-toggle-group">
        <label class="efx-mini-toggle" title="On: click or drag-select tokens on the canvas and the list follows (clicking a chip selects the token there too). With nothing selected, the visible hostile tokens are ticked. Off: only the list decides.">
          <input type="checkbox" name="useSel" checked>
          <span class="sw"></span>
          <span>Follow canvas</span>
        </label>
        <label class="efx-mini-toggle" title="Tick or clear every visible token in the list (hidden ones are never ticked this way)">
          <input type="checkbox" name="hostile" checked>
          <span class="sw"></span>
          <span>All</span>
        </label>
      </div>
      <div class="efx-party-count" title="Tokens (non-player) and player characters taking part in the encounter">
        <span class="count" data-count="foe">0</span><span>Tokens</span>
        <span class="efx-dot">·</span>
        <span class="count" data-count="pc">{{actors.length}}</span><span>Players</span>
      </div>
    </div>

    <div class="efx-strip-label efx-players-label">Players</div>
    <div class="efx-actor-strip" aria-label="Party">
      {{#each actors}}
        <label class="efx-actor-mini" title="{{name}}">
          <input type="checkbox" name="actor" value="{{id}}" {{#if checked}}checked{{/if}}>
          <img src="{{img}}" alt="{{name}}">
          <span>{{name}}</span>
        </label>
      {{/each}}
    </div>

    <div class="efx-strip-label efx-pets-label" hidden>Player-controlled <span class="efx-board-count">(familiars &amp; summons)</span></div>
    <div class="efx-actor-strip efx-pet-strip" aria-label="Player-controlled NPC tokens" hidden></div>

    <div class="efx-strip-label">On the board <span class="efx-board-count">(<b data-count="board">0</b>)</span></div>
    <div class="efx-actor-strip efx-foe-strip" aria-label="Tokens on the board"></div>
  </div>

  <footer class="efx-compact-foot">
    <button type="button" class="efx-ghost efx-preview-btn" data-act="preview">Preview</button>
    <button type="submit" class="efx-begin"><span>Start Encounter</span></button>
  </footer>
</div>
